with "regexp";

library project Greplib is
   for Library_Name use "greplib";
   for Library_Kind use "static";
   for Library_Interface use
     ("Greplib",
      "Greplib.Byte_Strings",
      "Greplib.Cancellation",
      "Greplib.Collected",
      "Greplib.Diagnostics",
      "Greplib.Directories",
      "Greplib.Events",
      "Greplib.Files",
      "Greplib.Internal",
      "Greplib.Internal.Execution_Plans",
      "Greplib.Internal.Filesystem",
      "Greplib.Internal.Regexp_Adapter",
      "Greplib.Options",
      "Greplib.Path_Filters",
      "Greplib.Paths",
      "Greplib.Patterns",
      "Greplib.Results",
      "Greplib.Search",
      "Greplib.Sources");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwe", "-gnatyM120");
   end Compiler;
end Greplib;
