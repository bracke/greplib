with "../greplib";
with "aunit";
with "project_tools";

project Greplib_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("greplib_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwe", "-gnatyM120");
   end Compiler;
end Greplib_Tests;
