with "project_tools.gpr";
with "tarlib.gpr";

project greplib_tool is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("greplib_tool.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwe", "-gnatyM120");
   end Compiler;
end greplib_tool;
